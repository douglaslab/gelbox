-  const laneWidth = gelSize.width / numLanes;
-  const wellWidth  = laneWidth * 0.5;
-  const wellHeight = laneWidth * 0.1;
+  const f = Math.fround;
+  const laneWidth = f(f(gelSize.width) / numLanes);
